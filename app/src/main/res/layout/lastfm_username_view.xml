<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/lastfm_sheet_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp"
        android:background="@color/spotifyplus_background">

    <View
            android:id="@+id/lastfm_sheet_handle"
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="22dp"
            android:background="@drawable/spotifyplus_bottom_sheet_handle"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="18dp">

        <ImageView
                android:id="@+id/lastfm_icon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:src="@drawable/lastfm"
                android:contentDescription="@string/lastfm_username_view_last_fm"/>

        <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="14dp"
                android:orientation="vertical">

            <TextView
                    android:id="@+id/lastfm_title"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/lastfm_title"
                    android:textColor="@color/white"
                    android:textSize="22sp"
                    android:textStyle="bold"/>

            <TextView
                    android:id="@+id/lastfm_description"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="@string/lastfm_subtitle"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp"
                    android:lineSpacingExtra="2dp"/>

        </LinearLayout>

    </LinearLayout>

    <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/lastfm_username_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="18dp"
            android:hint="@string/lastfm_hint"
            app:boxStrokeColor="#55FFFFFF"
            app:hintTextColor="#AAFFFFFF">

        <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/input_lastfm_username"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:textColorHint="#88FFFFFF"
                android:inputType="textPersonName"
                android:singleLine="true"/>

    </com.google.android.material.textfield.TextInputLayout>

    <com.google.android.material.button.MaterialButton
            android:id="@+id/btn_submit_lastfm"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="@string/lastfm_confirm"
            android:textAllCaps="false"
            android:textStyle="bold"
            app:cornerRadius="999dp"/>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_clear_lastfm"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/lastfm_clear"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="999dp"/>

        <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_lastfm"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:text="@string/lastfm_cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="999dp"/>

    </LinearLayout>

</LinearLayout>