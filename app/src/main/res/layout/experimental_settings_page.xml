<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.circularreveal.coordinatorlayout.CircularRevealCoordinatorLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/settings_root"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fitsSystemWindows="true"
        android:background="@color/spotifyplus_background">

    <com.google.android.material.appbar.AppBarLayout
            android:id="@+id/appbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:liftOnScroll="true">

        <com.google.android.material.appbar.MaterialToolbar
                android:id="@+id/experimental_toolbar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="#272727"
                android:gravity="center"
                app:titleCentered="true"
                app:title="Experimental"
                app:titleTextAppearance="@style/TextAppearance.Material3.TitleMedium"
                app:navigationIcon="?attr/homeAsUpIndicator"/>
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="match_parent"
                 android:fillViewport="true" android:paddingEnd="16dp"
                 android:paddingTop="16dp" android:paddingStart="16dp"
                 android:clickable="true" android:focusable="true"
                 app:layout_behavior="@string/appbar_scrolling_view_behavior">

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                      android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="@string/lyrics_header" style="@style/TextAppearance.Material3.TitleLarge"
                      android:paddingBottom="12dp"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="@drawable/row_click_bg">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/experiment_new_scroll"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:paddingBottom="4dp"/>

                    <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/experiment_new_scroll_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_new_scroller"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:checked="true"
                        android:contentDescription="@string/experiment_new_scroll"/>
            </LinearLayout>

            <LinearLayout
                    android:id="@+id/row_drift_background"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="72dp"
                    android:paddingVertical="8dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="@drawable/row_click_bg">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">
                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/experimental_settings_page_new_lyrics_background"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:paddingBottom="4dp"/>
                    <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/experiment_new_background"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_drift_background"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:checked="false"
                        android:contentDescription="@string/experimental_settings_page_drift_lyrics_background"/>
            </LinearLayout>

            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                      android:text="@string/experimental_ui_title" style="@style/TextAppearance.Material3.TitleLarge"
                      android:paddingBottom="12dp"/>

            <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp"
                    android:clickable="true" android:focusable="true"
                    android:background="@drawable/row_click_bg">

                <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                    <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/experiment_animated_artwork"
                            android:textColor="@color/white"
                            android:textSize="15sp"
                            android:paddingBottom="4dp"/>

                    <TextView
                            style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/experiment_animated_artwork_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_animated_art"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp"
                        android:checked="true"
                        android:contentDescription="@string/experiment_animated_artwork"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/row_immersive_animated_art"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="80dp" android:paddingVertical="8dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true"
                    android:background="@drawable/row_click_bg">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/experiment_immersive_artwork" android:textColor="@color/white"
                            android:textSize="15sp" android:paddingBottom="4dp"/>
                    <TextView style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/experiment_immersive_artwork"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_immersive_animated_art"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp" android:checked="false"
                        android:contentDescription="@string/experiment_immersive_artwork"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/row_now_playing_view"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="80dp" android:paddingVertical="8dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:layout_marginBottom="16dp" android:clickable="true" android:focusable="true"
                    android:background="@drawable/row_click_bg">

                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">

                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/experiment_redesign" android:textColor="@color/white"
                            android:textSize="15sp" android:paddingBottom="4dp"/>

                    <TextView style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/experiment_redesign_desc"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_now_playing_view"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp" android:checked="false"
                        android:contentDescription="@string/experiment_redesign"/>
            </LinearLayout>

            <LinearLayout android:id="@+id/row_animated_theme_background"
                    android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:minHeight="72dp" android:paddingVertical="8dp"
                    android:orientation="horizontal" android:gravity="center_vertical"
                    android:clickable="true" android:focusable="true"
                    android:background="@drawable/row_click_bg">
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/experiment_animated_background" android:textColor="@color/white"
                            android:textSize="15sp" android:paddingBottom="4dp"/>
                    <TextView style="@style/TextAppearance.Material3.BodySmall"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="@string/experiment_animated_background"
                            android:textColor="?attr/colorOnSurfaceVariant"/>
                </LinearLayout>
                <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switch_animated_theme_background"
                        android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:paddingHorizontal="8dp" android:checked="false"
                        android:contentDescription="@string/experiment_animated_background"/>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</com.google.android.material.circularreveal.coordinatorlayout.CircularRevealCoordinatorLayout>
