<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:id="@+id/color_picker_sheet_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/spotifyplus_background"
        android:orientation="vertical"
        android:paddingStart="20dp"
        android:paddingTop="10dp"
        android:paddingEnd="20dp"
        android:paddingBottom="24dp">

    <View
            android:layout_width="42dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="20dp"
            android:background="@drawable/spotifyplus_bottom_sheet_handle"/>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/color_picker_view_choose_color"
            android:textColor="@color/white"
            android:textSize="22sp"
            android:textStyle="bold"/>

    <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:layout_marginBottom="18dp"
            android:text="@string/color_picker_view_choose_any_color_you_want"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"/>

    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="240dp"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp">

        <FrameLayout
                android:id="@+id/color_picker_field"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

    </com.google.android.material.card.MaterialCardView>

    <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="36dp"
            android:layout_marginTop="14dp"
            app:cardCornerRadius="18dp"
            app:cardElevation="0dp"
            app:strokeColor="#33FFFFFF"
            app:strokeWidth="1dp">

        <FrameLayout
                android:id="@+id/color_picker_hue"
                android:layout_width="match_parent"
                android:layout_height="match_parent"/>

    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <com.google.android.material.card.MaterialCardView
                android:id="@+id/color_picker_preview"
                android:layout_width="52dp"
                android:layout_height="52dp"
                android:layout_marginEnd="14dp"
                app:cardCornerRadius="26dp"
                app:cardElevation="0dp"
                app:strokeColor="#55FFFFFF"
                app:strokeWidth="1dp"/>

        <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/color_picker_hex_layout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:hint="@string/color_picker_view_hex_color"
                app:boxStrokeColor="#55FFFFFF"
                app:helperText="#RRGGBB or #AARRGGBB"
                app:helperTextTextColor="?attr/colorOnSurfaceVariant"
                app:hintTextColor="#AAFFFFFF">

            <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/input_color_picker_hex"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:digits="#0123456789AaBbCcDdEeFf"
                    android:inputType="textCapCharacters"
                    android:maxLength="9"
                    android:singleLine="true"
                    android:textColor="@color/white"
                    android:textColorHint="#88FFFFFF"/>

        </com.google.android.material.textfield.TextInputLayout>

    </LinearLayout>

    <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_cancel_color_picker"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/lastfm_cancel"
                android:textAllCaps="false"
                android:textColor="@color/white"
                app:cornerRadius="999dp"/>

        <Space
                android:layout_width="10dp"
                android:layout_height="1dp"/>

        <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_select_color_picker"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:text="@string/color_picker_view_select"
                android:textAllCaps="false"
                android:textStyle="bold"
                app:cornerRadius="999dp"/>

    </LinearLayout>

</LinearLayout>
